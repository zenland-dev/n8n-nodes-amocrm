{
	"name": "@zenland-dev/n8n-nodes-amocrm",
	"version": "0.1.0",
	"description": "amoCRM (Kommo) nodes for n8n with account-aware dropdowns and a webhook trigger",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"amocrm",
		"kommo",
		"crm"
	],
	"license": "MIT",
	"homepage": "https://github.com/zenland-dev/n8n-nodes-amocrm",
	"author": {
		"name": "zenland-dev",
		"email": "zenland.dev@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zenland-dev/n8n-nodes-amocrm.git"
	},
	"bugs": {
		"url": "https://github.com/zenland-dev/n8n-nodes-amocrm/issues"
	},
	"engines": {
		"node": ">=20.19"
	},
	"main": "index.js",
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"format": "prettier nodes credentials --write",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AmoCrmApi.credentials.js",
			"dist/credentials/AmoCrmOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/AmoCrm/AmoCrm.node.js",
			"dist/nodes/AmoCrmTrigger/AmoCrmTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.46.4",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "^19.0.4",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
